# Copy this file's values into Vercel Project Settings → Environment Variables.
# Never commit a real .env file — .gitignore already excludes it.

# A long random string used to sign admin login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The password staff will type at /admin to sign in. Choose something you
# can share with the team but that a stranger couldn't guess.
ADMIN_PASSWORD=

# Set automatically once you add a Postgres/Neon integration from the
# Vercel Marketplace — you do not need to fill this in by hand.
DATABASE_URL=
